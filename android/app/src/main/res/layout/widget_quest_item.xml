<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_quest_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="4dp"
    android:paddingHorizontal="6dp">

    <TextView
        android:id="@+id/btn_check"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:background="@drawable/widget_checkbox_bg"
        android:gravity="center"
        android:text="◻"
        android:textColor="@color/widget_cyan"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_quest_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Quest Title"
        android:textColor="@color/widget_text_primary"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/tv_quest_xp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="+50 XP"
        android:textColor="@color/widget_gold"
        android:textSize="9sp" />

</LinearLayout>
