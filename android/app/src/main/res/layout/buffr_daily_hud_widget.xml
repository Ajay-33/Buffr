<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_hud_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Top Character HUD Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Hero Avatar & Name -->
        <TextView
            android:id="@+id/tv_hero_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="🎮 HERO"
            android:textColor="@color/widget_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Level Badge -->
        <TextView
            android:id="@+id/tv_level_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_badge_cyan"
            android:paddingHorizontal="5dp"
            android:paddingVertical="1dp"
            android:text="LVL 1"
            android:textColor="@color/widget_cyan"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Streak Badge -->
        <TextView
            android:id="@+id/tv_streak_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_badge_gold"
            android:paddingHorizontal="5dp"
            android:paddingVertical="1dp"
            android:text="🔥 1d"
            android:textColor="@color/widget_gold"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Gold Badge -->
        <TextView
            android:id="@+id/tv_gold_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_card_inner"
            android:paddingHorizontal="5dp"
            android:paddingVertical="1dp"
            android:text="💰 50G"
            android:textColor="@color/widget_gold"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- XP Progress Bar Segment -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_xp_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="XP: 0 / 100"
                android:textColor="@color/widget_text_secondary"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/tv_xp_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="@color/widget_cyan"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pb_xp_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="2dp"
            android:max="100"
            android:progress="25"
            android:progressDrawable="@drawable/widget_progress_bar" />
    </LinearLayout>

    <!-- Interactive Scrollable Quests Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_card_inner"
        android:orientation="vertical"
        android:padding="2dp">

        <!-- Quests Header (Non-scrollable) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/tv_quest_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚔️ TODAY'S QUESTS"
                android:textColor="@color/widget_cyan"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_quest_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/0 (0%)"
                android:textColor="@color/widget_gold"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Scrollable List of Quests -->
            <ListView
                android:id="@+id/lv_quest_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:scrollbars="none" />

            <!-- All Done / Empty State Label -->
            <TextView
                android:id="@+id/tv_all_done_label"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="🎉 All Daily Quests Conquered!"
                android:textColor="@color/widget_gold"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Action Launch & Sync Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_open_quests"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_action"
            android:gravity="center"
            android:paddingVertical="5dp"
            android:text="⚔️ OPEN BUFFR HUD"
            android:textColor="@color/widget_bg"
            android:textSize="10sp"
            android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_card_inner"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:paddingVertical="5dp"
                android:text="🔄"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
