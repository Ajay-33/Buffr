<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark Arcade Mini Widget Shell -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#090416" />
            <stroke
                android:width="2dp"
                android:color="#FACC15" />
            <corners android:radius="14dp" />
        </shape>
    </item>

    <!-- Inner Card Preview Simulation -->
    <item
        android:top="14dp"
        android:bottom="14dp"
        android:left="10dp"
        android:right="10dp">
        <shape android:shape="rectangle">
            <solid android:color="#150B2B" />
            <stroke
                android:width="1dp"
                android:color="#2E185B" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
